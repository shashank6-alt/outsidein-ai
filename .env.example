PORT=3001
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Set to an installed Ollama model name. If omitted, server uses the first installed model from Ollama /api/tags.
OLLAMA_MODEL=
OLLAMA_TIMEOUT_MS=20000

# Optional cloud fallback (disabled by default)
ENABLE_HF_FALLBACK=false
HF_API_KEY=
HF_MODEL=
HF_TIMEOUT_MS=20000
