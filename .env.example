PORT=3001
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Keep this exact model name in sync with the local Ollama installation.
OLLAMA_MODEL=gemma3:1b
# Local inference can take longer than a normal HTTP request, especially on first load.
OLLAMA_TIMEOUT_MS=120000

# Optional cloud fallback (disabled by default)
ENABLE_HF_FALLBACK=false
HF_API_KEY=
HF_MODEL=
HF_TIMEOUT_MS=20000
